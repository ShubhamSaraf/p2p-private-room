listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49200

# Set this to the VPS public IPv4 address. For NAT, use PUBLIC/PRIVATE.
external-ip=YOUR_PUBLIC_IP
realm=turn.shubhamsaraf.dev
server-name=turn.shubhamsaraf.dev

fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_HIGH_ENTROPY_SECRET
stale-nonce=600

cert=/etc/letsencrypt/live/turn.shubhamsaraf.dev/fullchain.pem
pkey=/etc/letsencrypt/live/turn.shubhamsaraf.dev/privkey.pem

no-cli
no-loopback-peers
no-multicast-peers
no-tlsv1
no-tlsv1_1
log-file=stdout
simple-log
